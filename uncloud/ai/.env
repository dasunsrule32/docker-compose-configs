# App 
TZ=America/New_York
DATA_PATH=/mnt/data/ai

# GPU
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=all

# Ollama
OLLAMA_CPU_FALLBACK=true
MODEL_PATH=/mnt/llm/ollama

# Open WebUI
WEBUI_SECRET_KEY=<random-key>
WEBUI_URL=https://ai.domain.com
OLLAMA_BASE_URL=http://ollama:11434
ENABLE_CHANNELS=true
ENABLE_PUBLIC_ACTIVE_USERS_COUNT=false
ENABLE_SIGNUP=false
DEFAULT_USER_ROLE=user
ENABLE_OAUTH_SIGNUP=true
OAUTH_CLIENT_ID=<client-id>
OAUTH_CLIENT_SECRET=<client-secret>
OAUTH_PROVIDER_NAME=My ID
OPENID_PROVIDER_URL=https://auth.domain.com/application/o/openai/.well-known/openid-configuration
OPENID_REDIRECT_URI=https://ai.domain.com/oauth/oidc/callback
